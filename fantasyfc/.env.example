# Supabase project settings (Project Settings -> API in your Supabase dashboard).
# The publishable/anon key is safe to expose client-side by design - it has no
# access beyond what the database's row-level security policies allow.
# Never put the service_role key in this file or any committed file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
